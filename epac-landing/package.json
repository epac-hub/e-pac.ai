    "lenis": "1.3.25",
    "lucide-react": "0.453.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/node": "24.7.0",
    "@types/react": "19.2.1",
    "@types/react-dom": "19.2.1",
    "@types/three": "0.185.0",
    "@vitejs/plugin-react": "5.0.4",
